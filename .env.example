# Copy to .env.local for your computer, and add the same names in
# Vercel → Settings → Environment Variables for the live site.

# Admin sign-in (/admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Any long random text; signs the sign-in cookie. Changing it signs everyone out.
AUTH_SECRET=

# Where admin edits are stored (Neon Postgres). Saves go live at once.
# The tables are created automatically on first use.
DATABASE_URL=

# Only if you are NOT using DATABASE_URL: edits are committed to this repo and Vercel redeploys.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens
# with access to this repository only and "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=Wayneurlt/GaeSugu
GITHUB_BRANCH=main
